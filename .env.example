# Example environment variables for SGEN
# Copy this file to .env and fill in your values

# JWT Secret (at least 32 characters)
JWT_SECRET=your-256-bit-secret-here

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com:50505

# Garmin Developer (Starter) — from developerportal.garmin.com
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://eskimoshome.freeddns.org/api/garmin/callback
# AES key for encrypting user tokens in DB (generate: openssl rand -hex 32)
GARMIN_TOKEN_KEY=
