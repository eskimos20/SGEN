# Exempel på miljövariabler för SGEN
# Kopiera denna fil till .env och fyll i dina värden

# JWT Secret (minst 32 tecken)
JWT_SECRET=din-256-bitars-secret-här

# CORS tillåtna domäner (kommaseparerad)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://din-domän.com:50505

# Garmin Developer (Starter) — från developerportal.garmin.com
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://eskimoshome.freeddns.org/api/garmin/callback
# AES-nyckel för kryptering av användartokens i DB (generera: openssl rand -hex 32)
GARMIN_TOKEN_KEY=
